{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0"
    xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
    xmlns:atom="http://www.w3.org/2005/Atom"
    xmlns:content="http://purl.org/rss/1.0/modules/content/"
    xmlns:podcast="https://podcastindex.org/namespace/1.0" >
    <channel>
        <title>{{ .Site.Title }}</title>
        <itunes:title>{{ .Site.Title }}</itunes:title>
        <link>{{ .Permalink }}</link>
        {{/* Some podcast validators only accept a bare ISO 639-1 code, so the region suffix is dropped here. */}}
        <language>{{ index (split .Site.LanguageCode "-") 0 }}</language>
        <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
        <copyright>Copyright {{ now.Year }} {{ .Site.Params.author }}</copyright>
        <itunes:subtitle>{{ .Site.Params.description }}</itunes:subtitle>
        <itunes:author>{{ .Site.Params.author }}</itunes:author>
        <itunes:summary>{{ .Site.Params.description }}</itunes:summary>
        <itunes:type>episodic</itunes:type>
        <description>{{ .Site.Params.description }}</description>
        <itunes:owner>
            <itunes:name>{{ .Site.Params.author }}</itunes:name>
            <itunes:email>{{ .Site.Params.email }}</itunes:email>
        </itunes:owner>
        <itunes:image href="{{ .Site.BaseURL }}images/logo.png" />
        {{ if isset .Site.Params "category"}}
        <itunes:category text="{{ .Site.Params.category }}">
        {{ else }}
        <itunes:category text="Technology">
        {{ end }}
            {{ if isset .Site.Params "subcategory"}}
            <itunes:category text="{{ .Site.Params.subcategory }}"/>
            {{ end }}
        </itunes:category>
        <itunes:explicit>false</itunes:explicit>
        <image>
            <url>{{ .Site.BaseURL }}images/logo.png</url>
            <title>{{ .Site.Title }}</title>
            <link>{{ .Site.BaseURL }}</link>
        </image>
        <podcast:funding url="https://patreon.com/thspod">Become a patron!</podcast:funding>
        <podcast:guid>daf9eb0a-c856-55e5-b4ac-80eb9a027100</podcast:guid>
        <podcast:locked>no</podcast:locked>
        <atom:link href="{{ .Site.BaseURL }}index.xml" rel="self" type="application/rss+xml" />
        {{ range .Site.RegularPages }}
        {{ if eq .Type "episode"}}
        <item>
            <title>{{ title .Title }}</title>
            <itunes:title>{{ title .Title }}</itunes:title>
            {{/* Apple requires episode numbers to be 1 or higher, so a trailer carries no episode number and becomes a season trailer. */}}
            {{ if not (eq (.Params.episode_type | default "full") "trailer") }}
            <podcast:episode display="{{ .Params.seasonName }} {{ .Params.episode }}">{{ .Params.episode }}</podcast:episode>
            <itunes:episode>{{ .Params.episode }}</itunes:episode>
            {{ end }}
            
            {{ if (isset .Params "season")}}
            <podcast:season name="{{ .Params.seasonName }}, Year {{ .Params.year }}">{{ .Params.season }}</podcast:season>
            <itunes:season>{{ .Params.season }}</itunes:season>
            {{ else }}
            <itunes:season>1</itunes:season>
            {{ end }}

            {{ if (isset .Params "episode_type")}}
            <itunes:episodeType>{{ .Params.episode_type }}</itunes:episodeType>
            {{ else }}
            <itunes:episodeType>full</itunes:episodeType>
            {{ end }}
            
            <itunes:author>{{ .Site.Params.author }}</itunes:author>
            {{/* Episodes are kept clean by design, so the flag defaults to false unless an episode says otherwise. */}}
            <itunes:explicit>{{ .Params.explicit | default false }}</itunes:explicit>
            {{/* Older episodes carry the transcript in the page body, which never belongs in the feed.
                 Apple strips heading tags from show notes, so section headings become bold paragraphs. */}}
            {{ $notes := .Content | replaceRE `(?s:<h1 id="transcript">Transcript</h1>.*)` "" | replaceRE `<h[2-6][^>]*>(.*?)</h[2-6]>` "<p><strong>$1</strong></p>" }}
            {{/* Apps that understand content:encoded show the HTML notes from there and treat description as a
                 plain summary, so description carries text only and stays well inside Apple's length limit. */}}
            <description>{{ .Params.Description }}

{{ $notes | replaceRE `<a [^>]*href="([^"]*)"[^>]*>.*?</a>` "$1" | plainify | htmlUnescape }}</description>
            <content:encoded>{{ "<![CDATA[" | safeHTML }}<p>{{ .Params.Description | safeHTML }}</p>
{{ $notes | safeHTML }}{{ "]]>" | safeHTML }}</content:encoded>
            <itunes:summary>{{ .Params.Description }}</itunes:summary>
            <enclosure url="https://r.zencastr.com/r/dts.podtrac.com/redirect.mp3/ymk.nyc3.digitaloceanspaces.com/{{ .Params.podcast }}" length="{{ .Params.podcast_bytes}}" type="audio/mpeg" />
            <guid isPermaLink="false">{{ .Params.guid }}</guid>
            <link>{{ .Permalink }}</link>
            <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }} </pubDate>
            <itunes:duration>{{ .Params.podcast_duration}}</itunes:duration>


            {{/* Advertise only the transcript files that exist in the episode bundle, so the feed never points at a 404. */}}
            {{ with .Resources.GetMatch "transcript.vtt" }}
            <podcast:transcript url="{{ .Permalink }}" type="text/vtt" />
            {{ end }}
            {{ with .Resources.GetMatch "transcript.txt" }}
            <podcast:transcript url="{{ .Permalink }}" type="text/plain" />
            {{ end }}
        </item>
        {{ end }}
        {{ end }}
  </channel>
</rss>